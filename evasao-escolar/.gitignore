data/raw/**
!data/raw/**/
!data/raw/**/README.md

# Dados gerados pelo pipeline
data/interim/
data/processed/

# Modelos treinados (apenas a pasta na raiz do projeto, não src/models/)
/models/

# Jupyter / IPython
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/
